# ============================================================================
#  SAR 民航飞机图像分类 —— .gitignore
# ----------------------------------------------------------------------------
#  总原则：**可由脚本重建的中间物不进版本库；交付物（指标/图表/报告）要进。**
# ============================================================================

# ---------------------------------------------------------------------------
#  1. 数据集本体
#     约 5 MB，可由官方仓库重新获取；且仓库无 LICENSE，不宜再分发。
#     获取方式见 README.md「数据准备」。
# ---------------------------------------------------------------------------
data/SAR-ACD/

# ---------------------------------------------------------------------------
#  2. conda / 虚拟环境（数 GB，可由 environment.yml 重建）
# ---------------------------------------------------------------------------
.conda/
envs/
venv/
.venv/
conda-meta/
pkgs/

# ---------------------------------------------------------------------------
#  3. Python 缓存
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.cache/
.pytest_cache/
.mypy_cache/
.playwright-mcp/

# ---------------------------------------------------------------------------
#  4. LaTeX 中间文件（build.sh 每次重跑都会重新生成）
# ---------------------------------------------------------------------------
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.blg
*.bbl
*.log

# 例外：实验日志是**可复现性证据**，必须入库
!results/**/*.log

# ---------------------------------------------------------------------------
#  5. 模型权重
#     【入库】
#       · 基线的 3 个 best_model.pt（各约 1 MB）
#       · **最终模型** results/raw/resnet18_seed123/best_model.pt（约 43 MB）
#         —— 用于在**不重新训练**的情况下验证 评估 → Grad-CAM → 图表 → 报告 链路
#     【排除】
#       · last_model.pt：与 best 重复，训练即可重建
#       · 另外两个 ResNet18 种子的 best_model.pt：各约 43 MB，冗余
#         （它们的指标/日志/预测已在库中，重训命令见 README）
# ---------------------------------------------------------------------------
results/raw/*/last_model.pt
results/raw/resnet18_seed42/best_model.pt
results/raw/resnet18_seed2024/best_model.pt

# ---------------------------------------------------------------------------
#  6. 运行目录内的 figures/ 副本
#     说明：这是早期一个缺陷（visualize.py 误判运行模式，smoke/formal 混淆）
#     留下的历史产物，内容与项目根 figures/ 下的同名文件**完全重复**（约 45 MB）。
#     规范图表一律在项目根的 figures/，此处不重复入库。
# ---------------------------------------------------------------------------
results/raw/*/figures/

# ---------------------------------------------------------------------------
#  7. 密钥与本机隐私
# ---------------------------------------------------------------------------
.env
*.key
*.pem
secrets.json
credentials.json
Thumbs.db
Desktop.ini
*.lnk
